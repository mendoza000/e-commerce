APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.tienda.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En dev via Herd: 127.0.0.1 (Postgres expuesto por docker-compose infra).
# Dentro de docker-compose (verificacion/prod): se sobreescribe a "db".
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tienda.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# En dev via Herd: 127.0.0.1. Dentro de docker-compose: "redis".
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://tienda.test
SANCTUM_STATEFUL_DOMAINS=tienda.test,api.tienda.test

RESERVATION_MINUTES=45
PAYMENT_REVIEW_MINUTES=4320

PAYMENT_PROOF_DISK=local
PAYMENT_PROOF_MAX_KB=5120

PRODUCT_IMAGE_DISK=public
PRODUCT_IMAGE_MAX_KB=5120

MAX_VARIANTS_PER_PRODUCT=500
MAX_IMAGES_PER_PRODUCT=30

CRIPTOYA_BASE_URL=https://criptoya.com/api
CRIPTOYA_EXCHANGE=binancep2p
CRIPTOYA_TIMEOUT=8
CRIPTOYA_RETRIES=2
