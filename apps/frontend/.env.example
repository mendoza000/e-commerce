# API base URL used by Server Components (read at runtime, never baked into the
# build). Inside Docker this is the container hostname, e.g. http://backend:8000.
API_URL=http://api.tienda.test

# API base URL as the *browser* reaches it. The admin panel authenticates with a
# Sanctum session cookie, so it calls the API directly and needs a publicly
# resolvable origin. It must share a parent domain with the frontend for the
# session cookie to be accepted (see SESSION_DOMAIN in the backend .env).
NEXT_PUBLIC_API_URL=http://api.tienda.test
